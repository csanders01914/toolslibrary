# The ToolsLibrary — standalone helpdesk assistant configuration.
# Copy to .env and fill in the real values. Never commit .env.

# Self-hosted Synapse homeserver.
HOMESERVER_URL=https://matrix.tools-library.com

# Access token for the helpbot account (create it once with the SDK CLI or
# Synapse's admin API, then revoke/rotate it if it ever leaks).
ACCESS_TOKEN=syt_your_bot_token_here

# Room allowlist — the bot processes events ONLY in these two rooms and
# rejects every other invite.
HELP_DESK_ROOM_ID=!INow90Ytx7b84MEGWwWn7f03oh8gF6ovjImC1uVsBzc
ADMIN_ROOM_ID=!0bHz6weMUTvTjV9Y-VoNfklMKdXGuQ7Lv2NAje86Cv8

# Webhook port for the website support form (POST /api/web-support).
# Defaults to 3005 so the bot never collides with the Next.js server
# (port 3000) in a shared container namespace. In the multi-container Podman
# deployment the website reaches this webhook at http://helpbot:3005 — the
# container's DNS name on a shared user-defined network, never localhost.
PORT=3005

# Platform database (required). Read-only usage: !tools, !search, and !status
# report the platform's live inventory. The relative path resolves against
# prisma/schema.prisma in the repository root, so file:../data/tool_library.db
# is the platform's SQLite volume.
DATABASE_URL="file:../data/tool_library.db"

# Shared secret for the website webhook. When set, the website must send the
# same value in the X-Webhook-Secret header (set HELPDESK_WEBHOOK_SECRET in the
# main repository's .env to the identical value). Recommended whenever the
# webhook port is reachable beyond loopback.
WEBHOOK_SECRET=
