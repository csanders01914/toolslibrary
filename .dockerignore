# .dockerignore — build-context filter for `podman build` (Buildah also honors
# .dockerignore when .containerignore is absent). Everything listed here is
# kept OUT of the image build context: secrets, live runtime data, editor
# backups, and regenerable outputs never reach the builder stage.

# --- Secrets & local environment (NEVER bake into an image) ---
.env
.env.local
.env.*.local
Recovery/

# --- Mail infrastructure secrets (Postfix/DKIM keys live on the host, never
# --- in the image: the website only sends SMTP to the relay, it never signs
# --- mail. A root-owned 0600 key file is also unreadable by the rootless
# --- copier under --userns=keep-id, which aborts `COPY . .` outright) ---
dkim/
*.private
*.key

# --- Runtime data volume (bind-mounted at `podman run`, never baked) ---
data/

# --- Dependencies & build outputs (regenerated inside the build) ---
node_modules/
.next/
out/
dist/
tsconfig.tsbuildinfo
next-env.d.ts

# --- VCS, handoff state, editor droppings ---
.git/
.gitignore
.handoff/
nppBackup/
*.bak
CONTEXT.md
CLEANUP_REPORT.md
IMPLEMENTATION_PLAN.md
AGENTS.md

# --- Docs & legacy design assets (not needed at runtime) ---
*.md
image.png
image(1).png

# --- Packaging & ops files themselves (not needed inside the image) ---
Containerfile
.dockerignore
deploy.sh
backup.sh
deploy/
scripts/

# --- Standalone Matrix helpdesk bot (separate npm project, never baked into the platform image) ---
tools-library-bot/

# Exclude local Postfix configuration
postfix/

main.cf
wiki/