# ToolsLibrary — website environment template.
# Copy to .env and fill in real values. Never commit the real .env.

# ── Core ──────────────────────────────────────────────────────────────────
# SQLite database (local dev). In Podman the Containerfile/deploy.sh set
# file:/app/data/tool_library.db instead.
DATABASE_URL="file:./data/tool_library.db"
# Session signing secret — 64+ chars, generate with: openssl rand -hex 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Canonical public origin — used by the NextAuth redirect guard and the
# warrant-canary confirmation links (PHASE_30). Must match the URL members
# actually browse to, or emailed approval links point at the wrong host.
NEXT_PUBLIC_SITE_URL="https://www.tools-library.com"

# ── Deterministic support & triage via your own Matrix homeserver ────────
# The listener stays dormant until these are set.
MATRIX_HOMESERVER_URL=""
MATRIX_BOT_USER_ID=""
MATRIX_BOT_ACCESS_TOKEN=""
MATRIX_ADMIN_ROOM_ID=""

# ── Standalone helpdesk assistant webhook (tools-library-bot) ────────────
# The website forwards support submissions there when set; if the assistant
# is down, the built-in engine takes over automatically. In production use
# the bot's Podman container DNS name (e.g. http://helpbot:3005), never
# localhost.
HELPDESK_WEBHOOK_URL=""
# Shared secret; must match WEBHOOK_SECRET in tools-library-bot/.env.
HELPDESK_WEBHOOK_SECRET=""

# ── Admin email notifications (local Postfix SMTP relay) ─────────────────
# Self-hosted loopback relay — no third-party email API, no API keys.
# SMTP_HOST/SMTP_PORT default to localhost:25 when empty; SMTP_FROM is the
# sender identity and must be set or admin alert emails are skipped silently
# (the notification email is still stored on the admin account).
SMTP_HOST="localhost"
SMTP_PORT="25"
# Sender identity, e.g. "ToolsLibrary <alerts@tools-library.com>".
SMTP_FROM=""
