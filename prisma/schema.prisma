generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(cuid())
  username           String        @unique
  alias              String
  passwordHash       String
  role               String        @default("USER") // "USER" | "ADMIN"
  mustChangePassword Boolean       @default(false) // Stock seeded credentials force a change on first login
  banned             Boolean       @default(false) // Set by admin (or via human-approved automated ban action)
  bio                String?
  trustScore         Int           @default(100)
  a11yPrefs          String?       // Anonymous JSON string for synced accessibility prefs
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  recoveryKeys RecoveryKey[]
  tools        Tool[]        @relation("OwnerTools")
  loans        Loan[]        @relation("BorrowerLoans")
  skills       Skill[]       @relation("OwnerSkills")
  sentMsgs     Message[]     @relation("SentMessages")
  receivedMsgs Message[]     @relation("ReceivedMessages")

  @@index([username])
}

model RecoveryKey {
  id        String    @id @default(cuid())
  keyHash   String    @unique
  usedAt    DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  status      String   @default("AVAILABLE") // "AVAILABLE" | "BORROWED" | "MAINTENANCE"
  imageUrl    String?
  ownerId     String
  owner       User     @relation("OwnerTools", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loans       Loan[]

  @@index([status, category])
  @@index([ownerId])
}

model Loan {
  id              String    @id @default(cuid())
  toolId          String
  tool            Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  borrowerId      String
  borrower        User      @relation("BorrowerLoans", fields: [borrowerId], references: [id], onDelete: Cascade)
  status          String    @default("REQUESTED") // "REQUESTED" | "APPROVED" | "ACTIVE" | "RETURNED" | "REJECTED"
  startDate       DateTime
  endDate         DateTime
  returnedAt      DateTime?
  returnCondition String?   // "GOOD" | "DAMAGED"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([toolId])
  @@index([borrowerId])
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  available   Boolean  @default(true)
  ownerId     String
  owner       User     @relation("OwnerSkills", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, available])
  @@index([ownerId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  fromId    String
  toId      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  sender    User     @relation("SentMessages", fields: [fromId], references: [id], onDelete: Cascade)
  receiver  User     @relation("ReceivedMessages", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, toId])
  @@index([toId, read])
}

// Automation provider configuration. Single-row table (upserted). The API key is
// stored AES-256-GCM encrypted (see src/lib/crypto.ts) and is NEVER returned
// to the client — only a masked hint (last 4 chars) is ever exposed.
model LlmConfig {
  id        String   @id @default(cuid())
  provider  String // "OPENROUTER" | "OPENAI" | "DEEPSEEK" | "ZAI" | "OLLAMA_LOCAL" | "CUSTOM"
  model     String // Free-form model id, e.g. "z-ai/glm-5.3", "deepseek-chat"
  baseUrl   String?  // Required only for CUSTOM providers
  apiKeyEnc String?  // AES-256-GCM ciphertext (iv:tag:ciphertext hex); null = keyless endpoint
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// User-submitted help requests, triaged in src/lib/services/triage.ts into
// either the automated pipeline or the admin intervention queue.
model HelpRequest {
  id           String   @id @default(cuid())
  userId       String?  // Set when an authenticated user files the request
  alias        String?  // Optional self-declared handle for guests (zero-PII)
  category     String // "TOOL_ISSUE" | "SKILL_ISSUE" | "LOAN_DISPUTE" | "ACCOUNT_ACCESS" | "SAFETY_INCIDENT" | "BUG_REPORT" | "GENERAL"
  message      String
  urgency      String // Classifier feature output: "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  route        String // Routing result: "LLM_AGENT" | "HUMAN_ADMIN"
  triageReason String
  confidence   Float // Agreement fraction for the winning route (0..1)
  status       String   @default("OPEN") // "OPEN" | "AGENT_DISPATCHED" | "RESOLVED" | "ESCALATED"
  resolution   String?  // Automated reply draft or admin resolution note
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, route])
}

// Audit trail + human-in-the-loop confirmation gate for automated tool calls.
// Destructive calls are ALWAYS created as status=PENDING and are never
// executed until an admin approves them (see src/lib/agent/tools.ts).
model AgentAction {
  id          String    @id @default(cuid())
  toolName    String
  argsJson    String
  destructive Boolean
  status      String    @default("PENDING") // "PENDING" | "AUTO_EXECUTED" | "EXECUTED" | "REJECTED" | "FAILED"
  resultJson  String?
  error       String?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([status])
}
