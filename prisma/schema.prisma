generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(cuid())
  username           String        @unique
  alias              String
  passwordHash       String
  role               String        @default("USER") // "USER" | "ADMIN"
  mustChangePassword Boolean       @default(false) // Stock seeded credentials force a change on first login
  banned             Boolean       @default(false) // Set by an admin from the console
  bio                String?
  trustScore         Int           @default(100)
  a11yPrefs          String?       // Anonymous JSON string for synced accessibility prefs
  notificationEmail String?       // PHASE_29: admin-only alert destination for admin alert emails via the local Postfix SMTP relay — the single deliberate PII exception (operator account only, never collected from members)
  canaryPassphraseHash String?       // PHASE_30: separate canary passphrase (bcrypt cost 12), independent of the login password; required to stage warrant-canary updates
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  recoveryKeys RecoveryKey[]
  tools        Tool[]        @relation("OwnerTools")
  loans        Loan[]        @relation("BorrowerLoans")
  skills       Skill[]       @relation("OwnerSkills")
  sentMsgs     Message[]     @relation("SentMessages")
  receivedMsgs Message[]     @relation("ReceivedMessages")
  vouchesGiven    Vouch[]    @relation("VouchesGiven")
  vouchesReceived Vouch[]    @relation("VouchesReceived")
  canaryPending CanaryPending?

  @@index([username])
}

model RecoveryKey {
  id        String    @id @default(cuid())
  keyHash   String    @unique
  usedAt    DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  status      String   @default("AVAILABLE") // "AVAILABLE" | "BORROWED" | "MAINTENANCE"
  imageUrl    String?
  ownerId     String
  owner       User     @relation("OwnerTools", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loans       Loan[]

  @@index([status, category])
  @@index([ownerId])
}

model Loan {
  id              String    @id @default(cuid())
  toolId          String
  tool            Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  borrowerId      String
  borrower        User      @relation("BorrowerLoans", fields: [borrowerId], references: [id], onDelete: Cascade)
  status          String    @default("REQUESTED") // "REQUESTED" | "APPROVED" | "ACTIVE" | "RETURNED" | "REJECTED"
  startDate       DateTime
  endDate         DateTime
  returnedAt      DateTime?
  returnCondition String?   // "GOOD" | "DAMAGED"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vouches Vouch[]

  @@index([toolId])
  @@index([borrowerId])
}

// Peer trust vouches (PHASE_25_TRUST_VOUCHING): the two participants of a
// RETURNED loan can vouch for their counterparty — one decision per loan per
// direction (unique on loanId+voucherId), either a vouch adjusting the
// counterparty's trustScore by VOUCH_DELTA (src/lib/constants.ts) or a final
// decline to vouch (declined=true, delta=0, no trust change). Zero PII:
// aliases only.
model Vouch {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  voucherId String
  voucher   User     @relation("VouchesGiven", fields: [voucherId], references: [id], onDelete: Cascade)
  voucheeId String
  vouchee   User     @relation("VouchesReceived", fields: [voucheeId], references: [id], onDelete: Cascade)
  delta     Int
  declined  Boolean  @default(false) // true = voucher chose not to vouch; recorded so the queue stops asking
  createdAt DateTime @default(now())

  @@unique([loanId, voucherId])
  @@index([voucheeId])
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  available   Boolean  @default(true)
  ownerId     String
  owner       User     @relation("OwnerSkills", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, available])
  @@index([ownerId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  fromId    String
  toId      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  sender    User     @relation("SentMessages", fields: [fromId], references: [id], onDelete: Cascade)
  receiver  User     @relation("ReceivedMessages", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, toId])
  @@index([toId, read])
}

// User-submitted help requests, triaged by the deterministic intent router
// (src/lib/intentRouter.ts) into either an instant pre-written reply or the
// admin intervention queue.
model HelpRequest {
  id           String   @id @default(cuid())
  userId       String?  // Set when an authenticated user files the request
  alias        String?  // Optional self-declared handle for guests (zero-PII)
  category     String // Detected intent key from src/lib/intentRouter.ts (e.g. "password_reset")
  message      String
  urgency      String // Escalation-derived: "LOW" (answered instantly) | "HIGH" (admin review)
  route        String // Routing result: "AUTO" | "ADMIN"
  triageReason String
  confidence   Float // Deterministic match confidence (always 1)
  status       String   @default("OPEN") // "OPEN" | "RESOLVED"
  resolution   String?  // Pre-written automated reply or admin resolution note
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, route])
}

// Warrant canary event log (PHASE_30_CANARY_SIGNING). Append-only public
// audit history: every committed canary action (monthly re-affirmation or
// disclosure) is recorded with an Ed25519 detached signature over the
// canonical payload. Deliberately NO foreign key to User — the public canary
// history must survive the deletion of any account, so the signing admin is
// snapshotted as plain public handles (alias + username, both public data).
model CanaryEvent {
  id            String   @id @default(cuid())
  seq           Int      @unique // monotonic sequence number, 1-based, allocated inside the commit transaction
  action        String // "AFFIRM" | "DISCLOSE"
  note          String? // operator note: optional context for AFFIRM, the required disclosure statement for DISCLOSE
  committedAt   DateTime
  expiresAt     DateTime? // AFFIRM only: committedAt + 30 days; null for DISCLOSE
  signature     String // Ed25519 detached signature (hex) over the canonical payload
  publicKey     String // Ed25519 public key (base64 SPKI DER) used at signing time
  adminAlias    String // snapshot of the signing admin's public alias at commit time
  adminUsername String // snapshot of the signing admin's public username at commit time
  createdAt     DateTime @default(now())

  @@index([committedAt])
}

// Staged (pending) canary update awaiting out-of-band email approval
// (PHASE_30). One per admin: staging a new update replaces any prior row.
// The raw confirmation token is never stored — only its SHA-256 hash; the
// single-use token is delivered exclusively via the admin notification email.
model CanaryPending {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // "AFFIRM" | "DISCLOSE"
  note      String?
  tokenHash String   @unique // SHA-256 hex of the single-use confirmation token
  expiresAt DateTime // stagedAt + 15 minutes
  createdAt DateTime @default(now())
}

// Ed25519 signing keypair for canary events (PHASE_30, singleton row).
// Generated on first commit. The private key is sealed with AES-256-GCM
// under a key derived from AUTH_SECRET (environment, never the database) so
// a database leak alone cannot re-sign forged history; it is decrypted only
// in memory, only to sign. The public key is published on /transparency so
// third parties can verify canary signatures offline. Operators record the
// public-key fingerprint out-of-band — a DB-tampered key swap is then
// detectable against that record.
model CanaryKey {
  id         String   @id @default(cuid())
  publicKey  String   @unique // base64 SPKI DER
  privateKey String // sealed: v1:<iv>:<ciphertext>:<authTag>, AES-256-GCM over the PKCS8 PEM
  createdAt  DateTime @default(now())
}
