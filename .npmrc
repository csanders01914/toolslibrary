# next-auth 5.0.0-beta.32 declares peerOptional nodemailer "^7.0.7 || ^8.0.5",
# but the GHSA nodemailer advisory line (fixed in 10.4.0, see PHASE_48) requires
# nodemailer 10. The peer is OPTIONAL and next-auth's nodemailer code path is
# unused here (credentials-only auth, no email provider), so the mismatch is
# benign. legacy-peer-deps lets npm tree operations (npm i / npm rm) resolve
# without failing ERESOLVE on that stale optional-peer range. npm ci is
# unaffected (it installs the lockfile as-is).
legacy-peer-deps=true
